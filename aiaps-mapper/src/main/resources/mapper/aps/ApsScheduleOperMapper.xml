<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.aiaps.mapper.aps.ApsScheduleOperMapper">

    <select id="selectByScheduleId" resultType="com.aiaps.domain.aps.ApsScheduleOper">
        SELECT *
        FROM aps_schedule_oper
        WHERE schedule_id = #{scheduleId}
        ORDER BY oper_no
    </select>

</mapper>
