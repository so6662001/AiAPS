<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.aiaps.mapper.base.BasAnnealRecipeMapper">

    <select id="selectCompatible" resultType="com.aiaps.domain.base.BasAnnealRecipe">
        SELECT *
        FROM bas_anneal_recipe
        WHERE (applicable_PATName = #{gradeCode} OR applicable_PATName IS NULL)
          AND is_active = 1
    </select>

</mapper>
