<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.aiaps.mapper.base.BasBomDetailMapper">

    <select id="selectByBomId" resultType="com.aiaps.domain.base.BasBomDetail">
        SELECT *
        FROM bas_bom_detail
        WHERE bom_id = #{bomId}
          AND is_active = 1
    </select>

</mapper>
