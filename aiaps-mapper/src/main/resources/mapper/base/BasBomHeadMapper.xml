<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.aiaps.mapper.base.BasBomHeadMapper">

    <select id="selectDefaultByPrdtId" resultType="com.aiaps.domain.base.BasBomHead">
        SELECT *
        FROM bas_bom_head
        WHERE PrdtID = #{prdtId}
          AND is_default = 1
          AND is_active = 1
    </select>

    <select id="selectAllActiveWithDetails" resultType="com.aiaps.domain.base.BasBomHead">
        SELECT h.*
        FROM bas_bom_head h
        WHERE h.is_active = 1
    </select>

</mapper>
