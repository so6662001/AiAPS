<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.aiaps.mapper.base.BasCategoryConfigMapper">

    <select id="selectByCategory" resultType="com.aiaps.domain.base.BasCategoryConfig">
        SELECT *
        FROM bas_category_config
        WHERE category_code = #{categoryCode}
        LIMIT 1
    </select>

</mapper>
