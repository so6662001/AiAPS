<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.aiaps.mapper.base.BasCustomerMaterialPrefMapper">

    <select id="selectByCustomer" resultType="com.aiaps.domain.base.BasCustomerMaterialPref">
        SELECT *
        FROM bas_customer_material_pref
        WHERE customer_code = #{customerCode}
          AND is_active = 1
    </select>

</mapper>
