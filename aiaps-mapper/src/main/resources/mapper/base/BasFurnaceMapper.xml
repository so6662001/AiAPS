<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.aiaps.mapper.base.BasFurnaceMapper">

    <select id="selectByStatus" resultType="com.aiaps.domain.base.BasFurnace">
        SELECT *
        FROM bas_furnace
        WHERE furnace_status = #{status}
          AND is_active = 1
    </select>

</mapper>
