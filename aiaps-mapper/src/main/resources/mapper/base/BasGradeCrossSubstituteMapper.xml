<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.aiaps.mapper.base.BasGradeCrossSubstituteMapper">

    <select id="selectCross" resultType="com.aiaps.domain.base.BasGradeCrossSubstitute">
        SELECT *
        FROM bas_grade_cross_substitute
        WHERE source_PATName = #{source}
          AND target_PATName = #{target}
          AND is_active = 1
    </select>

</mapper>
