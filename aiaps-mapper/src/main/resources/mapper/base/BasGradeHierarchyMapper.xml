<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.aiaps.mapper.base.BasGradeHierarchyMapper">

    <select id="selectByGradeCode" resultType="com.aiaps.domain.base.BasGradeHierarchy">
        SELECT *
        FROM bas_grade_hierarchy
        WHERE grade_code = #{gradeCode}
          AND is_active = 1
    </select>

    <select id="selectByFamily" resultType="com.aiaps.domain.base.BasGradeHierarchy">
        SELECT *
        FROM bas_grade_hierarchy
        WHERE grade_family = #{family}
          AND is_active = 1
        ORDER BY grade_level
    </select>

</mapper>
