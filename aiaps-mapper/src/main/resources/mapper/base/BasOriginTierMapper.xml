<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.aiaps.mapper.base.BasOriginTierMapper">

    <select id="selectByOriginCode" resultType="com.aiaps.domain.base.BasOriginTier">
        SELECT *
        FROM bas_origin_tier
        WHERE origin_code = #{originCode}
          AND is_active = 1
    </select>

</mapper>
