<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.aiaps.mapper.base.BasRoutingOperMapper">

    <select id="selectByRoutingId" resultType="com.aiaps.domain.base.BasRoutingOper">
        SELECT *
        FROM bas_routing_oper
        WHERE routing_id = #{routingId}
        ORDER BY oper_no
    </select>

</mapper>
