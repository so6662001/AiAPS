<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.aiaps.mapper.base.BasScheduleStrategyMapper">
    <select id="selectDefault" resultType="com.aiaps.domain.base.BasScheduleStrategy">
        SELECT * FROM bas_schedule_strategy
        WHERE is_default = 1 AND is_active = 1
        LIMIT 1
    </select>
</mapper>
