<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.aiaps.mapper.base.BasSpecFormulaMapper">

    <select id="selectByCode" resultType="com.aiaps.domain.base.BasSpecFormula">
        SELECT *
        FROM bas_spec_formula
        WHERE formula_code = #{formulaCode}
          AND is_active = 1
    </select>

</mapper>
