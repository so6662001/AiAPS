<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.aiaps.mapper.inventory.InvItemBarcodeMapper">

    <select id="selectByBarcode" resultType="com.aiaps.domain.inventory.InvItemBarcode">
        SELECT *
        FROM inv_item_barcode
        WHERE ItemBarcode = #{itemBarcode}
    </select>

</mapper>
