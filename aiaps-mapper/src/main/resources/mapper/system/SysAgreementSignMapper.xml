<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.aiaps.mapper.system.SysAgreementSignMapper">
    <select id="selectActiveByEnterprise" resultType="com.aiaps.domain.system.SysAgreementSign">
        SELECT * FROM sys_agreement_sign
        WHERE enterprise_id = #{enterpriseId} AND agreement_type = #{type} AND sign_status = 'ACTIVE'
    </select>
</mapper>
